# חובה - המודל הראשי שמייצר את הדו"ח
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# מומלץ - המודל השני שמבצע אימות מוצלב
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# אופציונלי - מסיר את הגבלת הקצב של NVD
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# אופציונלי - לסריקת ריפו פרטי ב-GitHub ולהעלאת מגבלת הקצב
# https://github.com/settings/tokens
GITHUB_TOKEN=

# מודלים (אופציונלי)
CLAUDE_MODEL=claude-opus-5-5
OPENAI_MODEL=gpt-5.6
